{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node -e \"console.log('HELLO_FROM_NODE');console.log('version:',process.version);setTimeout(()=>{const h=require('http');h.createServer((q,r)=>{r.end('ok')}).listen(3000,()=>console.log('listening on 3000'))},1000)\"",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
